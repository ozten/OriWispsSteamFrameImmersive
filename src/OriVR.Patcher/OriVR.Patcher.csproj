<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>OriVR.Patcher</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <BepInExDir>$(MSBuildThisFileDirectory)../../vendor/bepinex/BepInEx/core</BepInExDir>
    <OutDir>$(MSBuildThisFileDirectory)../../build/patchers/</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Reference><Private>false</Private></Reference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Reference Include="$(BepInExDir)/BepInEx.Core.dll" />
    <Reference Include="$(BepInExDir)/BepInEx.Preloader.Core.dll" />
    <Reference Include="$(BepInExDir)/SemanticVersioning.dll" />
  </ItemGroup>
</Project>
