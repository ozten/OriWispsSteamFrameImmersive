<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs BepInEx's Cpp2IL + Il2CppInterop generation natively (no emulation),
       using the exact library versions shipped in vendor/bepinex. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
    <BepInExDir>$(MSBuildThisFileDirectory)../../vendor/bepinex</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(BepInExDir)/BepInEx/core/*.dll" Exclude="$(BepInExDir)/BepInEx/core/dobby.dll;$(BepInExDir)/BepInEx/core/BepInEx.*.dll;$(BepInExDir)/BepInEx/core/0Harmony.dll;$(BepInExDir)/BepInEx/core/Il2CppInterop.Runtime.dll;$(BepInExDir)/BepInEx/core/Il2CppInterop.HarmonySupport.dll;$(BepInExDir)/BepInEx/core/MonoMod.*.dll" />
    <Reference Include="$(BepInExDir)/dotnet/Microsoft.Extensions.Logging.dll" />
    <Reference Include="$(BepInExDir)/dotnet/Microsoft.Extensions.Logging.Abstractions.dll" />
    <Reference Include="$(BepInExDir)/dotnet/Microsoft.Extensions.DependencyInjection.dll" />
    <Reference Include="$(BepInExDir)/dotnet/Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
    <Reference Include="$(BepInExDir)/dotnet/Microsoft.Extensions.Options.dll" />
    <Reference Include="$(BepInExDir)/dotnet/Microsoft.Extensions.Primitives.dll" />
  </ItemGroup>
</Project>
